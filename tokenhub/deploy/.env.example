# TokenHub 环境变量配置
# 复制此文件为 .env 并修改相应配置

# ==================== MySQL 配置 ====================
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_DATABASE=tokenhub
MYSQL_USER=tokenhub_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_PORT=3306

# ==================== Redis 配置 ====================
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# ==================== New API 安全配置 ====================
# 生成随机字符串作为密钥（可使用 openssl rand -base64 32 生成）
SESSION_SECRET=your_session_secret_here_change_this_to_random_string
CRYPTO_SECRET=your_crypto_secret_here_change_this_to_random_string

# ==================== Nginx 配置 ====================
# SSL 证书路径（如果使用 HTTPS）
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ==================== 邮件配置（可选） ====================
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM_NAME=TokenHub

# ==================== 支付配置（新开发功能） ====================
# 支付宝配置
# ALIPAY_APP_ID=your_alipay_app_id
# ALIPAY_PRIVATE_KEY=your_alipay_private_key
# ALIPAY_PUBLIC_KEY=alipay_public_key

# 微信支付配置
# WECHAT_APP_ID=your_wechat_app_id
# WECHAT_MCH_ID=your_wechat_merchant_id
# WECHAT_API_KEY=your_wechat_api_key

# 聚合支付配置（如 Payspi）
# PAYSPI_API_KEY=your_payspi_api_key
# PAYSPI_WEBHOOK_SECRET=your_payspi_webhook_secret

# ==================== 监控告警配置（可选） ====================
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# EMAIL_NOTIFICATION_ENABLED=false
